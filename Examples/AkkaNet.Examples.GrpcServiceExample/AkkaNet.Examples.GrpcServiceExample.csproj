<Project Sdk="Microsoft.NET.Sdk.Web">
	<Import Project="Common.props" />

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<!--<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>-->
	</PropertyGroup>

	<ItemGroup>
		<Protobuf Include="*/*.proto" GrpcServices="Server" ProtoRoot="Protos" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Controllers\**" />
	  <Content Remove="Controllers\**" />
	  <EmbeddedResource Remove="Controllers\**" />
	  <None Remove="Controllers\**" />
	  <Protobuf Remove="Controllers\**" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Remove="Actors\OverviewActor.cs" />
	  <Compile Remove="Processors\PointCloudCoordinateProcessor.cs" />
	  <Compile Remove="Processors\StatisticsCoordinateProcessor.cs" />
	  <Compile Remove="Services\CoordinatesService.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Include="Controllers\CoordinatesController.cs" />
	  <Compile Include="Controllers\HomeController.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akka.Streams" Version="1.5.43">
		  <TreatAsUsed>true</TreatAsUsed>
		</PackageReference>

		<PackageReference Include="Grpc.AspNetCore" Version="2.57.0" />
		<PackageReference Include="Grpc.Tools" Version="2.59.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1-Preview.1" />
	</ItemGroup>

</Project>